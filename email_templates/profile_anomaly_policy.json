{
  "content": "<#if execution.resultStatus == \"ERRORED\" || execution.resultStatus == \"SUCCESSFUL\" || execution.resultStatus == \"WARNING\">\n\t<!doctype html>\n\t<html>\n\n\t<head>\n\t\t<meta name=\"viewport\" content=\"width=device-width\"/>\n\t\t<meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\"/>\n\t\t<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family='Manrope', sans-serif;\">\n\t\t<title>Rule Execution Succeed</title>\n\t\t<style>\n      /* -------------------------------------\n\t\t\t\t\tGLOBAL RESETS\n\t\t\t------------------------------------- */\n\n      /*All the styling goes here*/\n\n      img {\n        border: none;\n        -ms-interpolation-mode: bicubic;\n        max-width: 100%;\n      }\n\n      body {\n        background-color: white;\n        font-family: 'Manrope', sans-serif;\n        -webkit-font-smoothing: antialiased;\n        font-size: 14px;\n        line-height: 1.4;\n        margin: 0;\n        padding: 0;\n        -ms-text-size-adjust: 100%;\n        -webkit-text-size-adjust: 100%;\n        color: #595353;\n        font-size: 16px;\n        font-weight: 300;\n        line-height: 22px;\n        text-align: left;\n      }\n\n      table {\n        border-collapse: separate;\n        mso-table-lspace: 0pt;\n        mso-table-rspace: 0pt;\n        table-layout: fixed;\n        width: 100%;\n      }\n\n      table td {\n        font-family: 'Manrope', sans-serif;\n        vertical-align: top;\n      }\n\n      /* -------------------------------------\n\t\t\t\t\tBODY & CONTAINER\n\t\t\t------------------------------------- */\n\n      .body {\n        background-color: white;\n        width: 100%;\n        color: #595353 !important;\n      }\n\n\n      /* This should also be a block element, so that it will fill 100% of the .container */\n      .content {\n        box-sizing: border-box;\n        display: block;\n        max-width: 580px;\n        padding: 10px;\n      }\n\n      .dashboard-link {\n        text-align: center;\n      }\n\n      /* -------------------------------------\n\t\t\tHEADER, FOOTER, MAIN\n\t\t\t------------------------------------- */\n      .main {\n        background: white;\n        border-radius: 4px;\n        width: 100%;\n      }\n\n      .wrapper {\n        box-sizing: border-box;\n        padding-bottom: 10px;\n      }\n\n      .container {\n        display: block;\n        padding: 10px 0px;\n        max-width: 800px;\n      }\n\n      .footer {\n        clear: both;\n        margin-top: 10px;\n        text-align: center;\n        width: 100%;\n      }\n\n      .footer td,\n      .footer p,\n      .footer span,\n      .footer a {\n        color: #999999;\n        font-size: 12px;\n      }\n\n      /* -------------------------------------\n\t\t\tTYPOGRAPHY\n\t\t\t------------------------------------- */\n      h1,\n      h2,\n      h3,\n      h4 {\n        color: #000000;\n        font-family: 'Manrope', sans-serif;\n        font-weight: 400;\n        line-height: 1.4;\n        margin: 0;\n        margin-bottom: 30px;\n      }\n\n      h1 {\n        font-size: 35px;\n        font-weight: 300;\n        text-align: center;\n        text-transform: capitalize;\n      }\n\n      p,\n      ul,\n      ol {\n        font-family: 'Manrope', sans-serif;\n        font-size: 14px;\n        font-weight: normal;\n        margin: 0;\n        margin-bottom: 15px;\n      }\n\n      p li,\n      ul li,\n      ol li {\n        list-style-position: inside;\n        margin-left: 5px;\n      }\n\n      a {\n        color: #3498db;\n        text-decoration: underline;\n      }\n\n      /* -------------------------------------\n\t\t\tBUTTONS\n\t\t\t------------------------------------- */\n      .btn {\n        box-sizing: border-box;\n        width: 100%;\n      }\n\n      .btn > tbody > tr > td {\n        padding-bottom: 15px;\n      }\n\n      .btn table {\n        width: auto;\n      }\n\n      .btn table td {\n        background-color: #ffffff;\n        border-radius: 5px;\n        text-align: center;\n      }\n\n      .btn a {\n        background-color: #ffffff;\n        border: solid 1px #3498db;\n        border-radius: 5px;\n        box-sizing: border-box;\n        color: #3498db;\n        cursor: pointer;\n        display: inline-block;\n        font-size: 14px;\n        font-weight: bold;\n        margin: 0;\n        padding: 12px 25px;\n        text-decoration: none;\n        text-transform: capitalize;\n      }\n\n      .btn-primary table td {\n        background-color: #3498db;\n      }\n\n      .btn-primary a {\n        background-color: #3498db;\n        border-color: #3498db;\n        color: #ffffff;\n      }\n\n      /* -------------------------------------\n\t\t\tOTHER STYLES THAT MIGHT BE USEFUL\n\t\t\t------------------------------------- */\n      .last {\n        margin-bottom: 0;\n      }\n\n      .first {\n        margin-top: 0;\n      }\n\n      .align-center {\n        text-align: center;\n      }\n\n      .align-right {\n        text-align: right;\n      }\n\n      .align-left {\n        text-align: left;\n      }\n\n      .clear {\n        clear: both;\n      }\n\n      .mt0 {\n        margin-top: 0;\n      }\n\n      .mb0 {\n        margin-bottom: 0;\n      }\n\n      .mx-10 {\n        margin-left: 10px;\n        margin-right: 10px;\n      }\n\n      .preheader {\n        color: transparent;\n        display: none;\n        height: 0;\n        max-height: 0;\n        max-width: 0;\n        opacity: 0;\n        overflow: hidden;\n        mso-hide: all;\n        visibility: hidden;\n        width: 0;\n      }\n\n      .powered-by a {\n        text-decoration: none;\n      }\n\n      hr {\n        border: 0;\n        border-bottom: 1px solid #f6f6f6;\n        margin: 20px 0;\n      }\n\n      /* -------------------------------------\n\t\t\tRESPONSIVE AND MOBILE FRIENDLY STYLES\n\t\t\t------------------------------------- */\n      @media only screen and (max-width: 620px) {\n        table[class=body] h1 {\n          font-size: 28px !important;\n          margin-bottom: 10px !important;\n        }\n\n        table[class=body] p,\n        table[class=body] ul,\n        table[class=body] ol,\n        table[class=body] td,\n        table[class=body] span,\n        table[class=body] a {\n          font-size: 16px !important;\n        }\n\n        table[class=body] .wrapper,\n        table[class=body] .article {\n          padding: 10px !important;\n        }\n\n        table[class=body] .content {\n          padding: 0 !important;\n        }\n\n        table[class=body] .container {\n          padding: 0 !important;\n          width: 100% !important;\n        }\n\n        table[class=body] .main {\n          border-left-width: 0 !important;\n          border-radius: 0 !important;\n          border-right-width: 0 !important;\n        }\n\n        table[class=body] .btn table {\n          width: 100% !important;\n        }\n\n        table[class=body] .btn a {\n          width: 100% !important;\n        }\n\n        table[class=body] .img-responsive {\n          height: auto !important;\n          max-width: 100% !important;\n          width: auto !important;\n        }\n      }\n\n      /* -------------------------------------\n\t\t\t\t\tPRESERVE THESE STYLES IN THE HEAD\n\t\t\t------------------------------------- */\n      @media all {\n        .ExternalClass {\n          width: 100%;\n        }\n\n        .ExternalClass,\n        .ExternalClass p,\n        .ExternalClass span,\n        .ExternalClass font,\n        .ExternalClass td,\n        .ExternalClass div {\n          line-height: 100%;\n        }\n\n        .apple-link a {\n          color: inherit !important;\n          font-family: inherit !important;\n          font-size: inherit !important;\n          font-weight: inherit !important;\n          line-height: inherit !important;\n          text-decoration: none !important;\n        }\n\n        .btn-primary table td:hover {\n          background-color: #34495e !important;\n        }\n\n        .btn-primary a:hover {\n          background-color: #34495e !important;\n          border-color: #34495e !important;\n        }\n      }\n\n      .acceldata-icon {\n        border-bottom: 1px solid #98d1fc;\n        margin-bottom: 10px;\n      }\n\n      .summary {\n        padding: 12px;\n        font-size: 1rem;\n        width: max-content;\n        background-color: #F2F4F8;\n      }\n\n      .asset-details {\n        font-size: 20px;\n        line-height: 28px;\n      }\n\n      .severity {\n        margin-right: 4px;\n        color: ${execution.severityColour};\n      }\n\n      .quality-score {\n        margin-right: 4px;\n        color: ${acceldata_color(result.qualityScore, (execution.thresholdLevel.config.warning)!)};\n      }\n\n      .assetName {\n        margin-left: 4px;\n        font-weight: 600;\n      }\n\n      .time-details {\n        font-size: 14px;\n        line-height: 20px;\n        color: #8F9AB2;\n        margin-top: 8px;\n      }\n\n      .metric-details {\n        padding: 8px 0px;\n        min-height: 60px;\n        border-bottom: 1px solid #E7E7E7;\n      }\n\n      .label {\n        font-size: 14px;\n        line-height: 16px;\n        font-weight: 500;\n        color: #8F9AB2;\n        padding: 8px 0px;\n        text-align: start;\n      }\n\n      .metric-value {\n        font-size: 30px;\n        font-weight: 600;\n        text-align: start;\n      }\n\n      .expected-value {\n        color: #25CB6D;\n      }\n\n\n      .metric-color {\n        color: #263046;\n      }\n\n      .impact-details {\n        padding-top: 1rem;\n        padding-bottom: 0.5rem;\n        font-weight: 500;\n        font-size: 16px;\n      }\n\n      .impact-title {\n        line-height: 24px;\n        margin-bottom: 8px;\n      }\n\n      .impact-item {\n        margin-right: 16px;\n        line-height: 18px;\n        color: #2B67CF;\n      }\n\n      .helpbook-title {\n        padding-top: 16px;\n        padding-bottom: 8px;\n        font-size: 14px;\n        line-height: 16px;\n        font-weight: 700;\n      }\n\n      .helpbook-desc {\n        margin-top: 6px;\n        font-size: 14px;\n        line-height: 18px;\n        font-weight: 400;\n        color: #45577E;\n      }\n\n      .helpbook-link {\n        color: #2F69E6;\n        font-size: 14px;\n        margin-right: 8px;\n        margin-left: 8px;\n      }\n\n      .button-class {\n        color: white !important;\n        background-color: #2B67CF;\n        cursor: pointer;\n        font-weight: 500;\n        font-size: 14px;\n        border: 1px solid transparent;\n        padding: 0.5rem 14px;\n        text-align: center;\n        border-radius: 8px;\n        text-decoration: none;\n        margin-bottom: 0.5rem;\n      }\n\n      a {\n        text-decoration: none;\n      }\n\n      .address {\n        font-size: 12px;\n        line-height: 18px;\n        font-weight: 600;\n        color: #8F9AB2;\n      }\n\n      .footer {\n        clear: both;\n        border-top: 1px solid #e7e7e7;\n        border-bottom: 1px solid #e7e7e7;\n        text-align: end;\n        padding: 1rem 0px;\n        width: 100%;\n      }\n\t\t</style>\n\t</head>\n\n\t<body class=\"\">\n\t<span class=\"preheader\">Rule :- ${policy.name}</span>\n\t<table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"body\">\n\t\t<tr>\n\t\t\t<td class=\"container\">\n\t\t\t\t<table role=\"presentation\" class=\"main\">\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td class=\"wrapper\">\n\t\t\t\t\t\t\t<table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\n\t\t\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t\t\t<td class=\"summary\">\n\t\t\t\t\t\t\t\t\t\t<table>\n\t\t\t\t\t\t\t\t\t\t\t<tbody>\n\t\t\t\t\t\t\t\t\t\t\t<tr class=\"asset-details\">\n\t\t\t\t\t\t\t\t\t\t\t\t<td>\n\t\t\t\t\t\t\t\t\t\t\t\t\t<span class=\"severity\">${acceldata_stringFormat(execution.severity)} Alert!</span>\n\t\t\t\t\t\t\t\t\t\t\t\t\t<span>${acceldata_stringFormat(policy.type)} Policy:\n                                                        <span class=\"assetName\">${policy.name}</span>\n                                                </span>\n\t\t\t\t\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t\t\t\t\t\t</tbody>\n\t\t\t\t\t\t\t\t\t\t</table>\n\t\t\t\t\t\t\t\t\t\t<table>\n\t\t\t\t\t\t\t\t\t\t\t<tbody>\n\t\t\t\t\t\t\t\t\t\t\t<tr class=\"time-details\">\n\t\t\t\t\t\t\t\t\t\t\t\t<td style=\"width:16rem\">Raised on : ${acceldata_dateFormat(execution.startedAt)}</td>\n\t\t\t\t\t\t\t\t\t\t\t\t<td style=\"width:2.5rem\">Asset:</td>\n\t\t\t\t\t\t\t\t\t\t\t\t<td>\n                          <#assign assetUidsStr = \"\">\n                            <#list assets as asset>\n                                <#if asset?index != 0>\n                                    <#assign assetUidsStr = assetUidsStr + \",\">\n                                </#if>\n                                <#assign assetUidsStr = assetUidsStr + asset.uid>\n                            </#list>\n                          ${assetUidsStr?replace(\".\", \" > \")}\n                        </td>\n\t\t\t\t\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t\t\t\t\t\t</tbody>\n\t\t\t\t\t\t\t\t\t\t</table>\n\t\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t\t\t<table class=\"metric-details\">\n\t\t\t\t\t\t\t\t\t\t<tbody>\n\t\t\t\t\t\t\t\t\t\t<tr class=\"p-row\">\n\t\t\t\t\t\t\t\t\t\t\t<td>\n\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"label\">Expected Score</div>\n\t\t\t\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t\t\t\t\t<td>\n\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"label\"> Actual Score</div>\n\t\t\t\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t\t\t\t\t<td>\n\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"label\">Threshold</div>\n\t\t\t\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t\t\t\t\t<tr class=\"p-row\">\n\t\t\t\t\t\t\t\t\t\t\t<td class=\"\">\n\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"metric-value expected-value\">${(execution.thresholdLevel.config.success)}%</div>\n\t\t\t\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t\t\t\t\t<td>\n\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"metric-value quality-score\">${result.qualityScore}%</div>\n\t\t\t\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t\t\t\t\t<td>\n\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"metric-value metric-color\">${acceldata_stringFormat(execution.resultStatus)}</div>\n\t\t\t\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t\t\t\t</table>\n\t\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t\t\t<td style=\"padding-bottom: 1rem;padding-top: 1rem;\">\n\t\t\t\t\t\t\t\t\t\t<a href=\"${execution.link}\" target=\"_blank\" class=\"button-class\">View Alert</a>\n\t\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t\t\t<td style=\"text-align: right\" class=\"dynamicBorderPadding\">\n\t\t\t\t\t\t\t\t\t\t<a href=\"https://www.acceldata.io/\">\n\t\t\t\t\t\t\t\t\t\t\t<img src=\"https://s3.amazonaws.com/docs.acceldata.dev/acceldata-logo-blue.png\" width=\"120\"\n\t\t\t\t\t\t\t\t\t\t\t\t\t height=\"25\">\n\t\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t\t\t<td style=\"text-align: right\">\n\t\t\t\t\t\t\t\t\t\t<span class=\"address\">1999 S. Bascom Avenue, Suite</span>\n\t\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t\t\t<td style=\"text-align: right\">\n\t\t\t\t\t\t\t\t\t\t<span class=\"address\">340, Campbell, CA 95008</span>\n\t\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t\t</table>\n\t\t\t\t\t\t</td>\n\t\t\t\t\t</tr>\n\t\t\t\t</table>\n\t\t\t</td>\n\t\t</tr>\n\t</table>\n\t</body>\n\t</html>\n</#if>",
  "subject": "<#if execution.resultStatus == \"ERRORED\" || execution.resultStatus == \"SUCCESSFUL\" || execution.resultStatus == \"WARNING\">\n\t[${tenant}: ${execution.severity?upper_case} ALERT] ${acceldata_stringFormat(policy.type)} Policy: ${policy.name};  Policy score : ${result.qualityScore}%\n</#if>"
}
