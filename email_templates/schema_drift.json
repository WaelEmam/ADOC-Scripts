{
  "content": "<#if execution.resultStatus == \"ERRORED\" || execution.resultStatus == \"WARNING\" || execution.resultStatus == \"SUCCESSFUL\">\n<#assign childAssetTypesStr = \"\">\n<#list result.driftSummary.childAssetTypes as asset>\n  <#if asset?index != 0><#assign childAssetTypesStr = childAssetTypesStr + \"/\"></#if>\n  <#assign childAssetTypesStr = childAssetTypesStr + asset.name>\n</#list>\n<#assign addedNames = (result.driftSummary.addedNames)![]>\n<#assign modifiedNames = (result.driftSummary.modifiedNames)![]>\n<#assign deletedNames = (result.driftSummary.deletedNames)![]>\n<#assign totalChanges = addedNames?size + modifiedNames?size + deletedNames?size>\n<!doctype html>\n<html>\n<head>\n  <meta name=\"viewport\" content=\"width=device-width\"/>\n  <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\"/>\n  <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700&display=swap\">\n  <title>Schema Drift</title>\n  <style>\n    body {\n      background-color: #f5f5f5;\n      font-family: 'Manrope', sans-serif;\n      -webkit-font-smoothing: antialiased;\n      font-size: 14px;\n      line-height: 1.4;\n      margin: 0;\n      padding: 20px;\n      color: #595353;\n    }\n\n    .email-container {\n      max-width: 800px;\n      margin: 0 auto;\n      background: white;\n      border-radius: 8px;\n      box-shadow: 0 2px 8px rgba(0,0,0,0.1);\n    }\n\n    .wrapper {\n      padding: 20px;\n    }\n\n    .summary {\n      padding: 12px;\n      font-size: 1rem;\n      background-color: #F2F4F8;\n      border-radius: 4px;\n    }\n\n    .asset-details {\n      font-size: 20px;\n      line-height: 28px;\n    }\n\n    .severity {\n      margin-right: 4px;\n      color: ${execution.severityColour};\n      font-weight: 600;\n    }\n\n    .assetName {\n      margin-left: 4px;\n      font-weight: 600;\n    }\n\n    .time-details {\n      font-size: 14px;\n      line-height: 20px;\n      color: #8F9AB2;\n      margin-top: 8px;\n    }\n\n    .metric-details {\n      width: 100%;\n      padding: 16px 0px;\n      border-bottom: 1px solid #E7E7E7;\n      border-collapse: collapse;\n    }\n\n    .metric-details td {\n      vertical-align: top;\n      padding: 0;\n    }\n\n    .label {\n      font-size: 14px;\n      line-height: 16px;\n      font-weight: 500;\n      color: #8F9AB2;\n      padding: 8px 0px;\n    }\n\n    .metric-value {\n      font-size: 30px;\n      font-weight: 600;\n    }\n\n    .added-value {\n      color: #25CB6D;\n    }\n\n    .modified-value {\n      color: #D97706;\n    }\n\n    .deleted-value {\n      color: #DC2626;\n    }\n\n    .metric-color {\n      color: #263046;\n    }\n\n    .snapshot-info {\n      font-size: 13px;\n      color: #8F9AB2;\n      padding: 12px 0px;\n      border-bottom: 1px solid #E7E7E7;\n    }\n\n    .snapshot-info strong {\n      color: #263046;\n    }\n\n    .notification-reason {\n      font-size: 13px;\n      font-style: italic;\n      color: #6B7280;\n      padding: 12px 0px;\n    }\n\n    .changes-section {\n      padding: 16px 0px;\n    }\n\n    .changes-title {\n      font-size: 16px;\n      font-weight: 600;\n      color: #263046;\n      margin-bottom: 12px;\n    }\n\n    .changes-table {\n      width: 100%;\n      border-collapse: collapse;\n      font-size: 12px;\n    }\n\n    .changes-table th {\n      background-color: #F2F4F8;\n      color: #6B7280;\n      font-weight: 600;\n      text-align: left;\n      padding: 10px 8px;\n      border-bottom: 1px solid #E7E7E7;\n      font-size: 11px;\n      text-transform: uppercase;\n    }\n\n    .changes-table td {\n      padding: 10px 8px;\n      border-bottom: 1px solid #E7E7E7;\n      vertical-align: middle;\n    }\n\n    .change-deleted {\n      color: #DC2626;\n      font-weight: 600;\n    }\n\n    .change-modified {\n      color: #D97706;\n      font-weight: 600;\n    }\n\n    .change-added {\n      color: #25CB6D;\n      font-weight: 600;\n    }\n\n    .overflow-message {\n      padding: 12px 0px;\n      font-size: 14px;\n    }\n\n    .overflow-link {\n      color: #2B67CF;\n      font-weight: 500;\n      text-decoration: underline;\n      cursor: pointer;\n    }\n\n    .button-class {\n      display: inline-block;\n      color: white !important;\n      background-color: #2B67CF;\n      cursor: pointer;\n      font-weight: 500;\n      font-size: 14px;\n      border: none;\n      padding: 10px 20px;\n      text-align: center;\n      border-radius: 8px;\n      text-decoration: none;\n      margin: 16px 0;\n    }\n\n    .footer {\n      text-align: right;\n      padding-top: 16px;\n      border-top: 1px solid #E7E7E7;\n      margin-top: 16px;\n    }\n\n    .address {\n      font-size: 12px;\n      line-height: 18px;\n      font-weight: 600;\n      color: #8F9AB2;\n    }\n\n    .logo {\n      margin-bottom: 8px;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"email-container\">\n    <div class=\"wrapper\">\n      <!-- Header -->\n      <div class=\"summary\">\n        <div class=\"asset-details\">\n          <span class=\"severity\">${acceldata_stringFormat(execution.severity)} Alert!</span>\n          <span>Schema Drift Policy: <span class=\"assetName\">${policy.name}</span></span>\n        </div>\n        <div class=\"time-details\">\n          Detected on: ${acceldata_dateFormat(execution.startedAt)} &nbsp;&nbsp;|&nbsp;&nbsp; Asset: ${assets[0].name} (${assets[0].assetType.name})\n        </div>\n      </div>\n\n      <!-- Drift Summary Metrics -->\n      <table class=\"metric-details\" role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\">\n        <tr>\n          <td width=\"25%\">\n            <div class=\"label\">${childAssetTypesStr}(s) Added</div>\n            <div class=\"metric-value added-value\">${(result.driftSummary.addedCount)!0}</div>\n          </td>\n          <td width=\"25%\">\n            <div class=\"label\">${childAssetTypesStr}(s) Modified</div>\n            <div class=\"metric-value modified-value\">${(result.driftSummary.modifiedCount)!0}</div>\n          </td>\n          <td width=\"25%\">\n            <div class=\"label\">${childAssetTypesStr}(s) Deleted</div>\n            <div class=\"metric-value deleted-value\">${(result.driftSummary.deletedCount)!0}</div>\n          </td>\n          <td width=\"25%\">\n            <div class=\"label\">Status</div>\n            <div class=\"metric-value metric-color\">${acceldata_stringFormat(execution.resultStatus)}</div>\n          </td>\n        </tr>\n      </table>\n\n      <!-- Snapshot Info -->\n      <div class=\"snapshot-info\">\n        Current Snapshot: <strong>${acceldata_dateFormat(result.driftSummary.rightSnapshotData.createdAt)}</strong>\n        &nbsp;&nbsp;|&nbsp;&nbsp;\n        Last Snapshot: <strong>${acceldata_dateFormat(result.driftSummary.leftSnapshotData.createdAt)}</strong>\n      </div>\n      <!-- Schema Changes Table -->\n      <#if totalChanges gt 0>\n      <div class=\"changes-section\">\n        <div class=\"changes-title\">Schema Changes (${totalChanges})</div>\n\n        <table class=\"changes-table\">\n          <thead>\n            <tr>\n              <th>Name</th>\n              <th>Change Type</th>\n            </tr>\n          </thead>\n          <tbody>\n            <#list deletedNames as name>\n            <tr>\n              <td>${name}</td>\n              <td class=\"change-deleted\">DELETED</td>\n            </tr>\n            </#list>\n            <#list modifiedNames as name>\n            <tr>\n              <td>${name}</td>\n              <td class=\"change-modified\">MODIFIED</td>\n            </tr>\n            </#list>\n            <#list addedNames as name>\n            <tr>\n              <td>${name}</td>\n              <td class=\"change-added\">ADDED</td>\n            </tr>\n            </#list>\n          </tbody>\n        </table>\n      </div>\n      </#if>\n\n      <!-- CTA Button -->\n      <a href=\"${execution.link}\" class=\"button-class\">View Details</a>\n\n      <!-- Footer -->\n      <div class=\"footer\">\n        <div class=\"logo\">\n          <img src=\"https://s3.amazonaws.com/docs.acceldata.dev/acceldata-logo-blue.png\" width=\"120\" height=\"25\" alt=\"Acceldata\">\n        </div>\n        <div class=\"address\">1999 S. Bascom Avenue, Suite</div>\n        <div class=\"address\">340, Campbell, CA 95008</div>\n      </div>\n    </div>\n  </div>\n</body>\n</html>\n</#if>\n",
  "subject": "<#if execution.resultStatus == \"ERRORED\" || execution.resultStatus == \"WARNING\" || execution.resultStatus == \"SUCCESSFUL\">\n\t[${tenant}: ${execution.severity?upper_case} ALERT] Schema Drift on ${assets[0].dataSourceName}; Added: ${(result.driftSummary.addedCount)!0} | Modified: ${(result.driftSummary.modifiedCount)!0} | Deleted: ${(result.driftSummary.deletedCount)!0}\n</#if>\n"
}
