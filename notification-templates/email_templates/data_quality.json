{
  "content": "<#if execution.resultStatus == \"ERRORED\" || execution.resultStatus == \"SUCCESSFUL\" || execution.resultStatus == \"WARNING\">\n<!doctype html>\n<html>\n<head>\n  <meta name=\"viewport\" content=\"width=device-width\"/>\n  <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\"/>\n  <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family='Manrope', sans-serif;\">\n  <title>Data Quality Policy Alert</title>\n  <style>\n    img {\n      border: none;\n      -ms-interpolation-mode: bicubic;\n      max-width: 100%;\n    }\n    body {\n      background-color: white;\n      font-family: 'Manrope', sans-serif;\n      -webkit-font-smoothing: antialiased;\n      font-size: 14px;\n      line-height: 1.4;\n      margin: 0;\n      padding: 0;\n      -ms-text-size-adjust: 100%;\n      -webkit-text-size-adjust: 100%;\n      color: #595353;\n      font-size: 16px;\n      font-weight: 300;\n      line-height: 22px;\n      text-align: left;\n    }\n    table {\n      border-collapse: separate;\n      mso-table-lspace: 0pt;\n      mso-table-rspace: 0pt;\n      table-layout: fixed;\n      width: 100%;\n    }\n    table td {\n      font-family: 'Manrope', sans-serif;\n      vertical-align: top;\n    }\n    .body {\n      background-color: white;\n      width: 100%;\n      color: #595353 !important;\n    }\n    .content {\n      box-sizing: border-box;\n      display: block;\n      max-width: 580px;\n      padding: 10px;\n    }\n    .main {\n      background: white;\n      border-radius: 4px;\n      width: 100%;\n    }\n    .wrapper {\n      box-sizing: border-box;\n      padding-bottom: 10px;\n    }\n    .container {\n      display: block;\n      padding: 10px 0px;\n      max-width: 800px;\n    }\n    .summary {\n      padding: 12px;\n      font-size: 1rem;\n      width: max-content;\n      background-color: #F2F4F8;\n    }\n    .asset-details {\n      font-size: 20px;\n      line-height: 28px;\n    }\n    .severity {\n      margin-right: 4px;\n      color: ${execution.severityColour};\n    }\n    .quality-score {\n      margin-right: 4px;\n      color: ${acceldata_color(result.qualityScore, (execution.thresholdLevel.config.warning)!)};\n    }\n    .assetName {\n      margin-left: 4px;\n      font-weight: 600;\n    }\n    .time-details {\n      font-size: 14px;\n      line-height: 20px;\n      color: #8F9AB2;\n      margin-top: 8px;\n    }\n    .metric-details {\n      padding: 8px 0px;\n      min-height: 60px;\n      border-bottom: 1px solid #E7E7E7;\n    }\n    .label {\n      font-size: 14px;\n      line-height: 16px;\n      font-weight: 500;\n      color: #8F9AB2;\n      padding: 8px 0px;\n      text-align: start;\n    }\n    .metric-value {\n      font-size: 30px;\n      font-weight: 600;\n      text-align: start;\n    }\n    .expected-value {\n      color: #25CB6D;\n    }\n    .metric-color {\n      color: #263046;\n    }\n    .button-class {\n      color: white !important;\n      background-color: #2B67CF;\n      cursor: pointer;\n      font-weight: 500;\n      font-size: 14px;\n      border: 1px solid transparent;\n      padding: 0.5rem 14px;\n      text-align: center;\n      border-radius: 8px;\n      text-decoration: none;\n      margin-bottom: 0.5rem;\n    }\n    a {\n      text-decoration: none;\n    }\n    .address {\n      font-size: 12px;\n      line-height: 18px;\n      font-weight: 600;\n      color: #8F9AB2;\n    }\n    .footer {\n      clear: both;\n      border-top: 1px solid #e7e7e7;\n      border-bottom: 1px solid #e7e7e7;\n      text-align: end;\n      padding: 1rem 0px;\n      width: 100%;\n    }\n  </style>\n</head>\n<body class=\"\">\n<span class=\"preheader\">Policy: ${policy.name}</span>\n<table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"body\">\n  <tr>\n    <td class=\"container\">\n      <table role=\"presentation\" class=\"main\">\n        <tr>\n          <td class=\"wrapper\">\n            <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\n              <tr>\n                <td class=\"summary\">\n                  <table>\n                    <tbody>\n                    <tr class=\"asset-details\">\n                      <td>\n                        <span class=\"severity\">${acceldata_stringFormat(execution.severity)} Alert!</span>\n                        <span>${acceldata_stringFormat(policy.type)} Policy:\n                          <span class=\"assetName\">${policy.name}</span>\n                        </span>\n                      </td>\n                    </tr>\n                    </tbody>\n                  </table>\n                  <table>\n                    <tbody>\n                    <tr class=\"time-details\">\n                      <td style=\"width:16rem\">Raised on: ${acceldata_dateFormat(execution.startedAt)}</td>\n                      <td style=\"width:2.5rem\">Asset:</td>\n                      <td>\n                        <#assign assetUidsStr = \"\">\n                        <#list assets as asset>\n                          <#if asset?index != 0>\n                            <#assign assetUidsStr = assetUidsStr + \",\">\n                          </#if>\n                          <#assign assetUidsStr = assetUidsStr + asset.uid>\n                        </#list>\n                        ${assetUidsStr?replace(\".\", \" > \")}\n                      </td>\n                    </tr>\n                    </tbody>\n                  </table>\n                </td>\n              </tr>\n              <tr>\n                <table class=\"metric-details\">\n                  <tbody>\n                  <tr class=\"p-row\">\n                    <td>\n                      <div class=\"label\">Expected Score</div>\n                    </td>\n                    <td>\n                      <div class=\"label\">Actual Score</div>\n                    </td>\n                    <td>\n                      <div class=\"label\">Threshold</div>\n                    </td>\n                  </tr>\n                  <tr class=\"p-row\">\n                    <td class=\"\">\n                      <div class=\"metric-value expected-value\">${(execution.thresholdLevel.config.success)}%</div>\n                    </td>\n                    <td>\n                      <div class=\"metric-value quality-score\">${result.qualityScore}%</div>\n                    </td>\n                    <td>\n                      <div class=\"metric-value metric-color\">${acceldata_stringFormat(execution.resultStatus)}</div>\n                    </td>\n                  </tr>\n                  </tbody>\n                </table>\n              </tr>\n\n              <!-- Notification reason -->\n              <#if result.notificationReason??>\n              <tr>\n                <td style=\"font-size: 13px; font-style: italic; color: #6B7280; padding: 12px 0px;\">\n                  <#if result.notificationReason == \"NEW_FAILURES\">\n                    You are receiving this notification because new rules started failing.\n                  <#elseif result.notificationReason == \"STATUS_CHANGE\">\n                    You are receiving this notification because status of 1 or more rules changed since the previous policy run.\n                  </#if>\n                </td>\n              </tr>\n              </#if>\n\n              <!-- Rule-level details -->\n              <#if result.alertingRules?? && (result.alertingRules?size > 0)>\n              <tr>\n                <td style=\"padding: 16px 0px;\">\n                  <div style=\"font-size: 16px; font-weight: 600; color: #263046; margin-bottom: 12px;\">\n                    Rules Requiring Attention (${result.alertingRulesCount})\n                  </div>\n\n                  <table style=\"width: 100%; border-collapse: collapse; font-size: 12px; table-layout: auto;\">\n                    <thead>\n                      <tr>\n                        <th style=\"background-color: #F2F4F8; color: #6B7280; font-weight: 600; text-align: left; padding: 10px 8px; border-bottom: 1px solid #E7E7E7; font-size: 11px; text-transform: uppercase;\">Rule</th>\n                        <th style=\"background-color: #F2F4F8; color: #6B7280; font-weight: 600; text-align: left; padding: 10px 8px; border-bottom: 1px solid #E7E7E7; font-size: 11px; text-transform: uppercase;\">Type</th>\n                        <th style=\"background-color: #F2F4F8; color: #6B7280; font-weight: 600; text-align: left; padding: 10px 8px; border-bottom: 1px solid #E7E7E7; font-size: 11px; text-transform: uppercase;\">Column</th>\n                        <th style=\"background-color: #F2F4F8; color: #6B7280; font-weight: 600; text-align: left; padding: 10px 8px; border-bottom: 1px solid #E7E7E7; font-size: 11px; text-transform: uppercase;\">Dimension</th>\n                        <th style=\"background-color: #F2F4F8; color: #6B7280; font-weight: 600; text-align: left; padding: 10px 8px; border-bottom: 1px solid #E7E7E7; font-size: 11px; text-transform: uppercase;\">Score</th>\n                        <th style=\"background-color: #F2F4F8; color: #6B7280; font-weight: 600; text-align: left; padding: 10px 8px; border-bottom: 1px solid #E7E7E7; font-size: 11px; text-transform: uppercase;\">Threshold (Pass/Warn)</th>\n                        <th style=\"background-color: #F2F4F8; color: #6B7280; font-weight: 600; text-align: left; padding: 10px 8px; border-bottom: 1px solid #E7E7E7; font-size: 11px; text-transform: uppercase;\">Rows (Pass/Fail/Total)</th>\n                        <th style=\"background-color: #F2F4F8; color: #6B7280; font-weight: 600; text-align: left; padding: 10px 8px; border-bottom: 1px solid #E7E7E7; font-size: 11px; text-transform: uppercase;\">Status</th>\n                      </tr>\n                    </thead>\n                    <tbody>\n                      <#-- ERRORED rules first -->\n                      <#list result.alertingRules as rule>\n                        <#if rule.status == \"ERRORED\">\n                        <tr>\n                          <td style=\"padding: 10px 8px; border-bottom: 1px solid #E7E7E7; vertical-align: middle;\">\n                            ${rule.name}\n                            <#if rule.isChanged>\n                              <span style=\"background-color: #FEE2E2; color: #DC2626; font-size: 10px; font-weight: 600; padding: 2px 6px; border-radius: 4px; margin-left: 4px;\">NEW</span>\n                            </#if>\n                          </td>\n                          <td style=\"padding: 10px 8px; border-bottom: 1px solid #E7E7E7; vertical-align: middle;\">${rule.type}</td>\n                          <td style=\"padding: 10px 8px; border-bottom: 1px solid #E7E7E7; vertical-align: middle;\">${rule.columnName!\"-\"}</td>\n                          <td style=\"padding: 10px 8px; border-bottom: 1px solid #E7E7E7; vertical-align: middle;\">${rule.dimension}</td>\n                          <td style=\"padding: 10px 8px; border-bottom: 1px solid #E7E7E7; vertical-align: middle; color: #DC2626;\">${rule.score}%</td>\n                          <td style=\"padding: 10px 8px; border-bottom: 1px solid #E7E7E7; vertical-align: middle;\">${rule.successThreshold}% / ${(rule.warningThreshold)!'-'}%</td>\n                          <td style=\"padding: 10px 8px; border-bottom: 1px solid #E7E7E7; vertical-align: middle;\">${rule.rowsPassed} / ${rule.rowsFailed} / ${rule.rowsProcessed}</td>\n                          <td style=\"padding: 10px 8px; border-bottom: 1px solid #E7E7E7; vertical-align: middle; color: #DC2626; font-weight: 600;\">ERRORED</td>\n                        </tr>\n                        </#if>\n                      </#list>\n                      <#-- WARNING rules second -->\n                      <#list result.alertingRules as rule>\n                        <#if rule.status == \"WARNING\">\n                        <tr>\n                          <td style=\"padding: 10px 8px; border-bottom: 1px solid #E7E7E7; vertical-align: middle;\">\n                            ${rule.name}\n                            <#if rule.isChanged>\n                              <span style=\"background-color: #FEF3C7; color: #D97706; font-size: 10px; font-weight: 600; padding: 2px 6px; border-radius: 4px; margin-left: 4px;\">NEW</span>\n                            </#if>\n                          </td>\n                          <td style=\"padding: 10px 8px; border-bottom: 1px solid #E7E7E7; vertical-align: middle;\">${rule.type}</td>\n                          <td style=\"padding: 10px 8px; border-bottom: 1px solid #E7E7E7; vertical-align: middle;\">${rule.columnName!\"-\"}</td>\n                          <td style=\"padding: 10px 8px; border-bottom: 1px solid #E7E7E7; vertical-align: middle;\">${rule.dimension}</td>\n                          <td style=\"padding: 10px 8px; border-bottom: 1px solid #E7E7E7; vertical-align: middle; color: #D97706;\">${rule.score}%</td>\n                          <td style=\"padding: 10px 8px; border-bottom: 1px solid #E7E7E7; vertical-align: middle;\">${rule.successThreshold}% / ${(rule.warningThreshold)!'-'}%</td>\n                          <td style=\"padding: 10px 8px; border-bottom: 1px solid #E7E7E7; vertical-align: middle;\">${rule.rowsPassed} / ${rule.rowsFailed} / ${rule.rowsProcessed}</td>\n                          <td style=\"padding: 10px 8px; border-bottom: 1px solid #E7E7E7; vertical-align: middle; color: #D97706; font-weight: 600;\">WARNING</td>\n                        </tr>\n                        </#if>\n                      </#list>\n                    </tbody>\n                  </table>\n\n                  <#-- Overflow message -->\n                  <#if (result.alertingRulesCount > result.alertingRules?size)>\n                    <div style=\"padding: 12px 0px; font-size: 14px;\">\n                      <span style=\"color: #2B67CF; font-weight: 500;\">\n                        + ${result.alertingRulesCount - result.alertingRules?size} more rule(s) need attention\n                      </span>\n                    </div>\n                  </#if>\n                </td>\n              </tr>\n              </#if>\n\n              <tr>\n                <td style=\"padding-bottom: 1rem;padding-top: 1rem;\">\n                  <a href=\"${execution.link}\" target=\"_blank\" class=\"button-class\">View Alert</a>\n                </td>\n              </tr>\n              <tr>\n                <td style=\"text-align: right\" class=\"dynamicBorderPadding\">\n                  <a href=\"https://www.acceldata.io/\">\n                    <img src=\"https://s3.amazonaws.com/docs.acceldata.dev/acceldata-logo-blue.png\" width=\"120\" height=\"25\">\n                  </a>\n                </td>\n              </tr>\n              <tr>\n                <td style=\"text-align: right\">\n                  <span class=\"address\">1999 S. Bascom Avenue, Suite</span>\n                </td>\n              </tr>\n              <tr>\n                <td style=\"text-align: right\">\n                  <span class=\"address\">340, Campbell, CA 95008</span>\n                </td>\n              </tr>\n            </table>\n          </td>\n        </tr>\n      </table>\n    </td>\n  </tr>\n</table>\n</body>\n</html>\n</#if>",
  "subject": "<#if execution.resultStatus == \"ERRORED\" || execution.resultStatus == \"SUCCESSFUL\" || execution.resultStatus == \"WARNING\">\n\t[${tenant}: ${(execution.severity)?upper_case} ALERT] ${acceldata_stringFormat(policy.type)} Policy: ${policy.name}; Score: ${result.qualityScore}%<#if (result.alertingRulesCount)?? && (result.alertingRulesCount > 0)>; Failing rules: ${result.alertingRulesCount}</#if>\n</#if>\n"
}
